# Server Configuration
PORT=4000
HOST=0.0.0.0

# Redis Configuration (Optional: If no Redis is found, falls back automatically to high-speed in-memory engine)
REDIS_URL=redis://127.0.0.1:6379
USE_REDIS_FALLBACK=true

# Rate Limiter Default Configuration
DEFAULT_ALGORITHM=sliding-window # sliding-window | token-bucket | fixed-window | leaky-bucket
RATE_LIMIT_WINDOW_MS=10000       # 10 seconds window
RATE_LIMIT_MAX_REQUESTS=20       # Max 20 requests per window
TOKEN_BUCKET_CAPACITY=20         # Burst capacity for token bucket
TOKEN_BUCKET_REFILL_RATE=2       # Tokens refilled per second

# Abuse Detection Thresholds
ABUSE_BURST_WINDOW_MS=2000       # 2 seconds micro-window
ABUSE_BURST_THRESHOLD=8          # More than 8 requests in 2 seconds triggers burst anomaly
ABUSE_ERROR_THRESHOLD=5          # 5+ 4xx/5xx in window
ABUSE_BLOCK_DURATION_SEC=180     # Ban duration for flagged offenders (3 minutes)
TARPIT_DELAY_MS=1200             # Delay added to throttled abusive clients
